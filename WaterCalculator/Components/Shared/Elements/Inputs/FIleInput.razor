@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public IBrowserFile? Value { get; set; }
    [Parameter] public EventCallback<IBrowserFile?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<IBrowserFile?>> ValueExpression { get; set; } = default!;

    private string SelectedFileName => Value?.Name ?? string.Empty;

    private async Task HandleChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        Value = file;
        await ValueChanged.InvokeAsync(file);
    }
} *@

