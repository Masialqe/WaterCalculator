@inject IJSRuntime JsRuntime
@inject ToastService ToastService

<button type="button"
        class="@CssClass"
        @onclick="HandleClick"
        aria-label="@AriaLabel"
        title="@Title"
        disabled="@Disabled">
    <svg class="h-4 w-4"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.8"
         aria-hidden="true">
        <rect x="9" y="9" width="10" height="10" rx="2"></rect>
        <path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
    </svg>
</button>

@code {
    [Parameter] public string? InputId { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Title { get; set; } = "Kopiuj";
    [Parameter] public string AriaLabel { get; set; } = "Kopiuj do schowka";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> OnCopied { get; set; }
    [Parameter] public string AdditionalClasses { get; set; } = string.Empty;

    private string CssClass =>
        $"inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-700 text-slate-300 transition hover:border-slate-600 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-cyan-400 disabled:cursor-not-allowed disabled:opacity-50 {AdditionalClasses}".Trim();

    private async Task HandleClick()
    {
        bool result;

        if (!string.IsNullOrWhiteSpace(InputId))
        {
            result = await JsRuntime.InvokeAsync<bool>("appClipboard.copyFromInputById", InputId);
        }
        else
        {
            result = await JsRuntime.InvokeAsync<bool>("appClipboard.copyText", Text ?? string.Empty);
        }

        await ToastService.ShowSuccessAsync("Skopiowano do schowka.");
        await OnCopied.InvokeAsync(result);
    }
}