<th scope="@Scope" class="@CssClass">
    @ChildContent
</th>

@code {
    [Parameter] public string Scope { get; set; } = "col";
    [Parameter] public string Align { get; set; } = "left";
    [Parameter] public string AdditionalClasses { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string CssClass =>
        $"px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-400 {GetAlignClass()} {AdditionalClasses}".Trim();

    private string GetAlignClass() => Align switch
    {
        "center" => "text-center",
        "right" => "text-right",
        _ => "text-left"
    };
}