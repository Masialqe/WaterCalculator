@page "/payoffs-archive"
@using WaterCalculator.Components.Payoffs
@using WaterCalculator.Features.Payoffs.GetList

@inject ToastService ToastService
@inject GetPayoffsHandler GetPayoffsHandler

@rendermode InteractiveServer

<div class="space-y-6 mb-5">
    <SectionHeader 
        SectionTitle="Archiwalne rozliczenia"
        SectionDescription="Podgląd historycznych rozliczeń dla wszystkich grup." />
</div>

<Box MaxWidth="full" PaddingClass="p-6">
    <div class="flex flex-col gap-6 p-3">
        @* <PrimaryButton OnClick="OpenGroupModal"> *@
        @*       Dodaj grupę *@
        @* </PrimaryButton> *@
        @* <Separator/> *@
        <SpinnerFallback IsLoading="_state.IsLoading" Message="Pobieram liste rozliczeń...">
            @if (_state.IsSuccess)
            {
                <PayoffsListComponent Payoffs="_payoffs"
                                     CurrentPage="_currentPage"
                                     PageSize="_pageSize"
                                     TotalPages="_totalPages"
                                     OnPayoffChanged="HandlePageChanged" />
            }

            @if (_state.IsError)
            {
                <ErrorMessage Message="@_state.ErrorMessage" />
            }
        </SpinnerFallback>
    </div>
</Box>

@code {
    [CascadingParameter] private CancellationToken CancellationToken { get; set; }

    private readonly List<PayoffListItem> _payoffs = [];
    private ComponentState _state = new();

    private int _currentPage = 1;
    private int _pageSize = 8;
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayoffsAsync();
    }

    private async Task LoadPayoffsAsync()
    {
        _state.SetLoading();

        var result = await GetPayoffsHandler.HandleAsync(
            new GetPayoffsQuery(_currentPage, _pageSize),
            CancellationToken);

        if (result.IsFailure)
        {
            _state.SetError(result.Error.ErrorDescription);
            return;
        }

        _payoffs.Clear();
        _payoffs.AddRange(result.Value.Items);

        _currentPage = result.Value.CurrentPage;
        _totalPages = result.Value.TotalPages;

        _state.SetSuccess();
    }

    private async Task HandlePageChanged(int page)
    {
        _currentPage = page;
        await LoadPayoffsAsync();
    }
}