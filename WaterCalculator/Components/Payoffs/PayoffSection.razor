<div class="space-y-6">
    <div class="flex flex-col">
        <h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Rozliczenia
        </h1>
        <p class="mt-2 text-sm text-slate-400 sm:text-base">
            Wybierz grupę, aby utworzyć nowe rozliczenie lub przejść do aktywnego.
        </p>
    </div>

    <Separator />

    <Box MaxWidth="full" PaddingClass="p-6">
        <div class="space-y-5">
            <GroupDictionary @bind-Value="_groupId"
                             SelectedValueExpression="() => _groupId" />

            @if (_groupId != Guid.Empty)
            {
                <PayoffManager GroupId="_groupId" />
            }
        </div>
    </Box>
</div>

@code {
    private Guid _groupId = Guid.Empty;
}