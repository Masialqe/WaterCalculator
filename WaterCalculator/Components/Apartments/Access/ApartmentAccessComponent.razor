@inject GenerateAccessToApartmentHandler GenerateAccessToApartmentHandler
@inject ToastService ToastService
@inject ApartmentUrlFactory ApartmentUrlFactory
@inject RegenerateAccessCodeHandler RegenerateAccessCodeHandler

@if (!Apartment.HasAccessConfigured)
{
    <SuccessButton OnClick="CreateAccessAsync">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 7a5 5 0 1 1-4.9 6H3v4h4v-2h2v-2h.1A5 5 0 0 1 14 7Z" />
        </svg>
    </SuccessButton>
}
else
{
    <SuccessButton OnClick="OpenEditAccessAsync">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3Z" />
        </svg>
    </SuccessButton>
}

<Modal @ref="_confirmationModal" Title="@GetModalTitle()">
    <ApartmentAccessTokenConfirmationComponent Url="@_currentUrl"
                                               Code="@_currentCode"
                                               IsEditMode="_isEditMode"
                                               ErrorMessage="@_errorMessage"
                                               OnGenerateNewCode="HandleGenerateNewCodeAsync" />
</Modal>

@code {
    [CascadingParameter] private CancellationToken CancellationToken { get; set; }

    [Parameter] public required ApartmentListItem Apartment { get; set; }
    [Parameter] public EventCallback OnAccessGenerated { get; set; }

    private Modal _confirmationModal = null!;
    private string _currentUrl = string.Empty;
    private string _currentCode = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isEditMode;

    private string GetModalTitle()
        => _isEditMode
            ? $"Dostęp do {Apartment.Name}"
            : $"Klucz dostępu dla {Apartment.Name}";

    private async Task CreateAccessAsync()
    {
        _errorMessage = string.Empty;
        _isEditMode = false;

        var result = await GenerateAccessToApartmentHandler.HandleAsync(
            Apartment.Id,
            CancellationToken);

        if (result.IsFailure)
        {
            await ToastService.ShowFailureAsync(result.Error.ErrorDescription);
            return;
        }

        _currentCode = result.Value.Code;
        _currentUrl = ApartmentUrlFactory.GetApartmentAccessUrl(result.Value.Token);

        await _confirmationModal.ShowModalAsync();
        await OnAccessGenerated.InvokeAsync();
    }

    private async Task OpenEditAccessAsync()
    {
        _errorMessage = string.Empty;
        _isEditMode = true;
        _currentCode = string.Empty;
        _currentUrl = ApartmentUrlFactory.GetApartmentAccessUrl(Apartment.PublicToken!);

        await _confirmationModal.ShowModalAsync();
    }

    private async Task HandleGenerateNewCodeAsync()
    {
        var result = await RegenerateAccessCodeHandler.HandleAsync(
            new RegenerateAccessCodeCommand(Apartment.Id, Apartment.PublicToken!),
            CancellationToken);

        if (result.IsFailure)
        {
            await ToastService.ShowFailureAsync("Nie udało się wygenerować nowego kodu.");
            return;
        }

        _currentCode = result.Value;
    }
}