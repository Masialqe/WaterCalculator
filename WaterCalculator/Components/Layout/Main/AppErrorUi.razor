<div id="blazor-error-ui"
     data-nosnippet
     class="fixed inset-x-4 bottom-4 z-50 hidden rounded-2xl border border-rose-500/30 bg-slate-900 px-4 py-3 text-sm text-slate-100 shadow-2xl shadow-black/40">
    <div class="flex items-center justify-between gap-3">
        <span>An unhandled error has occurred.</span>

        <div class="flex items-center gap-2">
            <a href="."
               class="rounded-lg border border-slate-700 px-3 py-1.5 text-slate-200 transition hover:bg-slate-800">
                Reload
            </a>

            <button type="button"
                    class="rounded-lg border border-slate-700 px-3 py-1.5 text-slate-200 transition hover:bg-slate-800"
                    aria-label="Dismiss error">
                ×
            </button>
        </div>
    </div>
</div>